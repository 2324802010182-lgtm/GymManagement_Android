<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF3A1018" android:centerColor="#FF211014" android:endColor="#FF111114" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#FFB52D36" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="170dp" android:height="170dp">
        <shape android:shape="oval">
            <solid android:color="#28F02D3A" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="140dp" android:height="100dp">
        <shape android:shape="oval">
            <solid android:color="#20B5121B" />
        </shape>
    </item>
</layer-list>
