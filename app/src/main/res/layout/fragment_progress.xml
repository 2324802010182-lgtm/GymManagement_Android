<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/prog_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prog_title" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/prog_ranges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <com.example.gymmanagement.ui.components.StateLayout
                android:id="@+id/prog_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="260dp">

                <LinearLayout
                    android:id="@+id/prog_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/prog_card_sessions"
                            layout="@layout/view_stat_card" />

                        <include
                            android:id="@+id/prog_card_minutes"
                            layout="@layout/view_stat_card" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/prog_card_attendance"
                            layout="@layout/view_stat_card" />

                        <include
                            android:id="@+id/prog_card_weight"
                            layout="@layout/view_stat_card" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prog_weight_chart" />

                        <TextView
                            android:id="@+id/prog_weight_empty"
                            style="@style/Text.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/prog_weight_empty" />

                        <com.example.gymmanagement.ui.components.LineChartView
                            android:id="@+id/prog_weight_chart"
                            android:layout_width="match_parent"
                            android:layout_height="190dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/prog_weight_chart" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/prog_bar_title"
                            style="@style/Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/prog_bar_empty"
                            style="@style/Text.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/prog_bar_empty" />

                        <com.example.gymmanagement.ui.components.BarChartView
                            android:id="@+id/prog_bar_chart"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/prog_bar_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prog_goal_title" />

                        <TextView
                            android:id="@+id/prog_goal_text"
                            style="@style/Text.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/prog_goal_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"
                            app:indicatorColor="@color/primary"
                            app:trackColor="@color/bg_surface"
                            app:trackCornerRadius="6dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/prog_goal_weight"
                            style="@style/Text.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/prog_goal_edit"
                            style="@style/Widget.Gym.Button.Small.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/action_set_goal" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/prog_measure"
                        style="@style/Widget.Gym.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/action_body_measurements"
                        app:icon="@drawable/ic_ruler" />
                </LinearLayout>
            </com.example.gymmanagement.ui.components.StateLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
