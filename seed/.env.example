# Sao chép thành seed/.env (file này đã được .gitignore) hoặc export các biến trong terminal.
# KHÔNG bao giờ commit khóa dịch vụ (service account) hay mật khẩu thật.

# ID dự án Firebase (kiểm tra lại trong Firebase Console > Project settings)
GCLOUD_PROJECT=gymmanagement-tdmu

# Đường dẫn tới khóa service account NẰM NGOÀI thư mục dự án, ví dụ:
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\gymmanagement-serviceAccount.json
GOOGLE_APPLICATION_CREDENTIALS=

# Mật khẩu dùng cho các tài khoản mẫu (bắt buộc, tối thiểu 8 ký tự, tự đặt – không có mặc định)
SEED_PASSWORD=

# (Tùy chọn) Email của MỘT tài khoản Auth đã có sẵn để cấp quyền quản trị nền tảng (platformAdmins/{uid})
SEED_ADMIN_EMAIL=
